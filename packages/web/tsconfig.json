{
  "extends": "../core/tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "jsx": "react",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hyperchat/core/*": [
        "../core/src/*"
      ],
      "@dadigua/hyperchat-shared/*": [
        "../shared/src/*"
      ],
      "@dadigua/hyperchat-shared": [
        "../shared/src/index.ts"
      ]
    },
  },
  "include": [
    "src",
    "types",
    "eval"
  ],
  "exclude": [
    "node_modules",
    "src/pages/hyperAgent",
    "src/pages/chat",
    "src/pages/market",
    "src/pages/hypertools"
  ]
}