{
  "extends": "../core/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "jsx": "react",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hyperchat/shared/*": [
        "../core/src/shared/*"
      ],
    },
  },
  "include": [
    "src",
    "types",
    "eval"
  ],
  "exclude": [
    "node_modules"
  ]
}