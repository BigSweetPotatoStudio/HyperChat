{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../",
    "paths": {
      "@hyperchat/core/*": [
        "../core/src/*"
      ],
      "@hyperchat/shared/*": [
        "../shared/src/*"
      ],
      "@hyperchat/shared": [
        "../shared/src/index.ts"
      ],
    }
  },
  "include": [
    "src/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}