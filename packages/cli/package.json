{
  "name": "@hyperchat/cli",
  "version": "0.0.0",
  "description": "HyperChat CLI - Command line interface for HyperChat",
  "author": "Dadigua <0laopo0@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hyperchat": "bin/hyperchat.js",
    "hc": "bin/hyperchat.js"
  },
  "scripts": {
    "dev": "cross-env myEnv=dev nodemon -w src --exec npx tsx src/index.mts",
    "start": "npm run dev",
    "build": "tsc --project tsconfig.json",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@hyperchat/core": "file:../core"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/update-notifier": "^6.0.8"
  },
  "keywords": [
    "cli",
    "ai",
    "chat",
    "assistant",
    "hyperchat"
  ],
  "files": [
    "dist",
    "bin",
    "README.md"
  ]
}