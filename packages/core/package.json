  "main": "dist/main.mjs",
  "module": "dist/main.mjs",
  "bin": {
    "hyperchat": "dist/core/src/cli/index.mjs",
    "hc": "dist/core/src/cli/index.mjs"
  },
  "files": [
    "dist/**/*",
    "web-build/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.d.mts",
      "import": "./dist/lib.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigSweetPotatoStudio/HyperChat.git"
  },
