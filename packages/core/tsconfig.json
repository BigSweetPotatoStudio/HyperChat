{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "paths": {
      "@dadigua/hyperchat-shared/*": [
        "../shared/src/*"
      ],
      "@dadigua/hyperchat-shared": [
        "../shared/src/index.ts"
      ]
    },
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "src",
    "types",
    "**/*.json",
    "../shared/src",
    "../shared/src/**/*.json",
  ],
  "exclude": [
    "node_modules",
    "../electron"
  ]
}