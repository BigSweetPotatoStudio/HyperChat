{
  "$schema": "./settings.schema.json",
  "workspace": {
    "name": "HyperChat",
    "created": 1752422400000
  },
  "appearance": {
    "isDarkMode": false,
    "theme": "auto",
    "fontSize": "medium",
    "language": "zh-CN"
  },
  "editor": {
    "autoSave": true,
    "autoSaveDelay": 5000,
    "wordWrap": true,
    "tabSize": 2
  },
  "aiConfig": {
    "prompt": "你是一个通用人工智能",
    "modelKey": "openrouter:google/gemini-2.5-flash-preview",
    "maxTokens": 30000
  },
  "defaultAI": {
    "streamResponse": true
  },
  "advanced": {
    "enableTelemetry": false,
    "debugMode": false,
    "experimentalFeatures": false
  }
}